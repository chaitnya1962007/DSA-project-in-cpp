#include <iostream>
#include <string>
using namespace std;

const int MAX = 10;

struct Coach {
    int coachNumber;
    string coachType;
};

// Stack for attached coaches
class Stack {
    Coach arr[MAX];
    int top;

public:
    Stack() {
        top = -1;
    }

    bool isEmpty() {
        return top == -1;
    }

    bool isFull() {
        return top == MAX - 1;
    }

    void push(Coach c) {
        if (isFull()) {
            cout << "Train coach stack is full!\n";
            return;
        }

        arr[++top] = c;
        cout << "Coach attached successfully.\n";
    }

    void pop() {
        if (isEmpty()) {
            cout << "No coach available to remove!\n";
            return;
        }

        cout << "Removed Coach: "
             << arr[top].coachNumber << " ("
             << arr[top].coachType << ")\n";

        top--;
    }

    void display() {
        if (isEmpty()) {
            cout << "No coaches attached.\n";
            return;
        }

        cout << "\nAttached Coaches (Top to Bottom):\n";

        for (int i = top; i >= 0; i--) {
            cout << "Coach Number: " << arr[i].coachNumber
                 << ", Type: " << arr[i].coachType << '\n';
        }
    }
};

// Circular queue for waiting coaches
class Queue {
    Coach arr[MAX];
    int front, rear, count;

public:
    Queue() {
        front = 0;
        rear = -1;
        count = 0;
    }

    bool isEmpty() {
        return count == 0;
    }

    bool isFull() {
        return count == MAX;
    }

    void enqueue(Coach c) {
        if (isFull()) {
            cout << "Waiting queue is full!\n";
            return;
        }

        rear = (rear + 1) % MAX;
        arr[rear] = c;
        count++;

        cout << "Coach added to waiting queue.\n";
    }

    bool dequeue(Coach &c) {
        if (isEmpty()) {
            cout << "No waiting coaches available!\n";
            return false;
        }

        c = arr[front];
        front = (front + 1) % MAX;
        count--;

        return true;
    }

    void display() {
        if (isEmpty()) {
            cout << "No coaches in waiting queue.\n";
            return;
        }

        cout << "\nWaiting Coaches (FIFO Order):\n";

        for (int i = 0; i < count; i++) {
            int index = (front + i) % MAX;

            cout << "Coach Number: " << arr[index].coachNumber
                 << ", Type: " << arr[index].coachType << '\n';
        }
    }
};

int main() {
    Stack train;
    Queue waiting;
    Coach c;
    int choice;

    do {
        cout << "\n===== TRAIN COACH MANAGEMENT =====\n";
        cout << "1. Add Coach to Train\n";
        cout << "2. Remove Last Coach\n";
        cout << "3. Add Coach to Waiting Queue\n";
        cout << "4. Attach Next Waiting Coach\n";
        cout << "5. Display Attached Coaches\n";
        cout << "6. Display Waiting Coaches\n";
        cout << "7. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
        case 1:
            cout << "Enter coach number: ";
            cin >> c.coachNumber;
            cout << "Enter coach type: ";
            cin >> c.coachType;
            train.push(c);
            break;

        case 2:
            train.pop();
            break;

        case 3:
            cout << "Enter coach number: ";
            cin >> c.coachNumber;
            cout << "Enter coach type: ";
            cin >> c.coachType;
            waiting.enqueue(c);
            break;

        case 4:
            if (waiting.dequeue(c)) {
                cout << "Attaching Coach "
                     << c.coachNumber << "...\n";
                train.push(c);
            }
            break;

        case 5:
            train.display();
            break;

        case 6:
            waiting.display();
            break;

        case 7:
            cout << "Program terminated.\n";
            break;

        default:
            cout << "Invalid choice! Try again.\n";
        }

    } while (choice != 7);

    return 0;
}
