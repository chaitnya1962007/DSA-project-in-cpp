#include <iostream>
#include <vector>
#include <queue>
#include <algorithm>
#include <climits>
#include <string>
using namespace std;

const long long INF = LLONG_MAX;

int main() {
    int n, m;

    cout << "Enter number of servers: ";
    cin >> n;

    if (n <= 0) {
        cout << "Number of servers must be positive.\n";
        return 0;
    }

    cout << "Enter number of network links: ";
    cin >> m;

    if (m < 0) {
        cout << "Number of links cannot be negative.\n";
        return 0;
    }

    // Graph representation:
    // Each server is a vertex, and each link has a latency.
    vector<vector<pair<int, int>>> adj(n);

    cout << "Enter links as: server1 server2 latency\n";
    cout << "Server numbers range from 0 to " << n - 1 << ".\n";

    for (int i = 0; i < m; i++) {
        int u, v, w;
        cin >> u >> v >> w;

        if (u < 0 || u >= n ||
            v < 0 || v >= n || w < 0) {
            cout << "Invalid link or latency.\n";
            return 0;
        }

        // Network links are bidirectional.
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }

    int source;

    cout << "Enter source server: ";
    cin >> source;

    if (source < 0 || source >= n) {
        cout << "Invalid source server.\n";
        return 0;
    }

    vector<long long> dist(n, INF);

    // Min-priority queue stores {distance, server}.
    priority_queue<
        pair<long long, int>,
        vector<pair<long long, int>>,
        greater<pair<long long, int>>
    > pq;

    dist[source] = 0;
    pq.push({0, source});

    // Dijkstra's Algorithm
    while (!pq.empty()) {
        long long d = pq.top().first;
        int u = pq.top().second;
        pq.pop();

        // Ignore outdated queue entries.
        if (d != dist[u])
            continue;

        for (auto edge : adj[u]) {
            int v = edge.first;
            int weight = edge.second;

            // Prevent overflow when adding distances.
            if (d > INF - weight)
                continue;

            long long newDist = d + weight;

            if (newDist < dist[v]) {
                dist[v] = newDist;
                pq.push({newDist, v});
            }
        }
    }

    // Collect reachable servers.
    vector<pair<long long, int>> ranking;

    for (int i = 0; i < n; i++) {
        if (dist[i] != INF) {
            ranking.push_back({dist[i], i});
        }
    }

    // Sort by latency, then by server number.
    sort(ranking.begin(), ranking.end());

    cout << "\nSource Server: " << source << "\n";
    cout << "\nServers Ranked by Minimum Latency\n";
    cout << "Rank\tServer\tMinimum Latency\n";

    for (int i = 0; i < (int)ranking.size(); i++) {
        cout << i + 1 << "\t"
             << ranking[i].second << "\t"
             << ranking[i].first << "\n";
    }

    cout << "\nUnreachable Servers:\n";

    bool found = false;

    for (int i = 0; i < n; i++) {
        if (dist[i] == INF) {
            cout << "Server " << i << "\n";
            found = true;
        }
    }

    if (!found) {
        cout << "None\n";
    }

    return 0;
}
